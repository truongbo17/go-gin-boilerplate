# Copy to .env, then set a unique 32+ character JWT secret.
APP_ENV=local
APP_NAME=GoGinBase
APP_PORT=8000
APP_URL=http://localhost:8000
CORS_ALLOW_ORIGIN=http://localhost:3000

# MySQL is required for auth and migrations.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=go_gin
DB_PASS=
MYSQL_ROOT_PASSWORD=
DB_DATABASE=go_gin

# local works for a single instance. Use Redis for shared cache and workers.
CACHE_STORE=local
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=120
JWT_REFRESH_EXPIRATION_DAYS=7

# Optional OTEL export
TRACER_ENABLE=false
TRACER_SAMPLE_RATIO=0.1
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_SERVICE_NAME=go-gin-boilerplate
ELASTIC_APM_ENVIRONMENT=local
